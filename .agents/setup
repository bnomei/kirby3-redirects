#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v composer >/dev/null || ! php -r 'exit(PHP_VERSION_ID >= 80300 && extension_loaded("gd") && extension_loaded("curl") && extension_loaded("mbstring") && extension_loaded("dom") ? 0 : 1);'; then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends composer php-cli php-curl php-gd php-intl php-mbstring php-xml php-zip
fi

composer install --no-interaction --prefer-dist
