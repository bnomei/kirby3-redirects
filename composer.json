{
  "name": "bnomei/kirby3-redirects",
  "type": "kirby-plugin",
  "description": "Setup performant HTTP Status Code Redirects from within the Kirby Panel",
  "homepage": "https://github.com/bnomei/kirby3-redirects",
  "version": "6.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Bruno Meilick",
      "email": "b@bnomei.com"
    }
  ],
  "keywords": [
    "kirby",
    "kirby6",
    "kirby-cms",
    "kirby-plugin",
    "redirect",
    "301",
    "302",
    "307",
    "308",
    "status-codes",
    "header",
    "redirects",
    "performance",
    "regex",
    "placeholder",
    "protection",
    "hack",
    "dos",
    "attack",
    "shield",
    "firewall",
    "defense"
  ],
  "config": {
    "vendor-dir": "tests/vendor",
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "autoload": {
    "psr-4": {
      "Bnomei\\": "classes/"
    }
  },
  "require": {
    "php": ">=8.3",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "getkirby/cms": "^6.0",
    "laravel/pint": "^1.13",
    "pestphp/pest": "^v3.5.1",
    "phpstan/phpstan": "^2.1",
    "spatie/ray": "^1.39"
  },
  "scripts": {
    "stan": "phpstan",
    "fix": "pint",
    "test": "pest --profile",
    "dist": [
      "composer fix",
      "COMPOSER_VENDOR_DIR=vendor composer install --no-dev --optimize-autoloader",
      "git rm -rf --cached .; git add .;"
    ],
    "kirby": "@composer install"
  },
  "extra": {
    "kirby-cms-path": "tests/kirby"
  },
  "suggest": {
    "bnomei/kirby3-feed": "Add Atom/JSON/RSS feeds or XML-Sitemap to your Kirby site.",
    "bnomei/kirby3-monolog": "Logging for Kirby with Monolog, ideal if you want to start tracking the hooks",
    "bnomei/kirby3-robots-txt": "Automatic robots.txt. Detects and adds XML-Sitemaps from plugins.",
    "bnomei/kirby3-security-headers": "CSP headers to make the the web a saver place. Sensible defaults with zero configuration."
  }
}
